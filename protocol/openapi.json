                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid credential"
          },
          "403": {
            "description": "Cross-origin request"
          },
          "404": {
            "description": "Unknown resource"
          },
          "409": {
            "description": "Conflict or stale proof"
          },
          "429": {
            "description": "Rate limited"
          }
