        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "repositories",
                  "topics",
                  "minutes",
                  "public"
                ],
                "properties": {
                  "repositories": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "topics": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "minutes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 480
                  },
                  "public": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved preferences"
          },
          "400": {
            "description": "Invalid preferences"
          }
        }
      }
