      "get": {
        "summary": "Read tasks",
        "responses": {
          "200": {
            "description": "JSON result"
          }
        }
      },
      "post": {
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
