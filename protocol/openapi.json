  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Platform credential; auth/github-token instead takes a GitHub identity token"
      }
    },
    "schemas": {
      "Project": {
        "type": "object",
        "required": [
          "repository",
          "name",
          "description",
          "topics",
          "commit_sha",
          "instructions",
          "instructions_path",
          "enabled"
        ],
        "properties": {
          "repository": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "commit_sha": {
            "type": "string"
          },
          "instructions": {
            "type": "string"
          },
          "instructions_path": {
            "type": "string"
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "enabled": {
            "type": [
              "integer",
              "boolean"
            ]
          },
          "checked": {
            "type": "integer"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Claim": {
        "type": "object",
        "required": [
          "task",
          "token",
          "expires",
          "instructions",
          "commit_sha"
        ],
        "properties": {
          "task": {
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "instructions": {
            "type": "string"
          },
          "commit_sha": {
            "type": "string"
          },
          "expires": {
            "type": "integer"
          }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "instructions": {
            "type": "string"
          },
          "instructions_path": {
            "type": "string"
          },
          "commit_sha": {
            "type": "string"
          },
          "donor": {
            "type": [
              "string",
              "null"
            ]
          },
          "expires": {
            "type": [
              "integer",
              "null"
            ]
          },
          "attempts": {
            "type": "integer"
          }
        }
      },
      "Report": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "task": {
            "type": "string"
          },
          "outcome": {
            "type": "string"
          },
          "report": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          },
          "donor": {
            "type": "string"
          },
          "result_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "created": {
            "type": "integer"
          }
        }
      }
    }
  }
}
