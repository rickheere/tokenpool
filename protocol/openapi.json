            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "projects",
                  "repositories",
                  "failures"
                ],
                "properties": {
                  "projects": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Project"
                    }
                  },
                  "repositories": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "failures": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "repository",
                        "error"
                      ],
                      "properties": {
                        "repository": {
                          "type": "string"
                        },
                        "error": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
